{
  "version": 1,
  "obsidian": {
    "vault_root": "",
    "pm_projects_folder": "Projects",
    "pm_tasks_folder": "Projects/tasks",
    "default_view": "kanban"
  },
  "git": {
    "default_branch": "main",
    "user_name": "",
    "user_email": "",
    "remote_provider": "github",
    "remote_owner": "",
    "use_gh_cli_if_available": true,
    "allow_remote_repo_creation": false
  },
  "execution": {
    "mode": "supervised_agentic",
    "dry_run_default": true,
    "allow_parallel_readonly_agents": true,
    "allow_parallel_write_agents": false,
    "require_control_authority_for_merge": true
  },
  "superpowers": {
    "required": true,
    "harness": "auto",
    "skills_root": "auto",
    "worktree_policy": "delegate_to_superpowers",
    "required_skills": [
      "brainstorming",
      "writing-plans",
      "executing-plans",
      "using-git-worktrees",
      "finishing-a-development-branch",
      "test-driven-development",
      "systematic-debugging",
      "verification-before-completion",
      "subagent-driven-development",
      "dispatching-parallel-agents",
      "requesting-code-review",
      "receiving-code-review",
      "writing-skills"
    ],
    "optional_skills": [
      "preserving-productive-tensions"
    ]
  },
  "archivist": {
    "required": true,
    "initialize_missing": "ask",
    "weekly_maintenance_enabled": true,
    "maintenance_interval_days": 7
  },
  "scripts": {
    "output_format": "json",
    "write_logs": true,
    "backup_before_apply": true
  },
  "agent_runtime": {
    "detection": "auto",
    "fallback_profile": "manual-supervised",
    "current_runtime": "auto"
  },
  "checkpointing": {
    "enabled": true,
    "strategy": "local_commit_per_approved_step",
    "commit_message_template": "checkpoint({project_slug}): step {step_number} - {description}",
    "require_clean_step_scope": true,
    "require_tests_before_commit": true,
    "require_reviewer_approval_before_commit": true,
    "allow_push_checkpoint_commits": false,
    "finalization_strategy": "ask_control_authority"
  }
}
